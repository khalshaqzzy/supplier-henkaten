{
  "name": "@tmmin-henkaten/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "nest start --watch",
    "clean": "tsc --build tsconfig.build.json --clean",
    "generate": "prisma generate --config prisma.config.ts",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "openapi:generate": "nest build && node dist/openapi/generate.js --write",
    "openapi:check": "nest build && node dist/openapi/generate.js --check",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "admin:bootstrap": "node dist/cli/admin.js bootstrap",
    "admin:recover": "node dist/cli/admin.js recover"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/throttler": "6.5.0",
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@tmmin-henkaten/contracts": "workspace:*",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "multer": "2.2.0",
    "nestjs-pino": "4.6.1",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "zod": "4.4.3",
    "zod-openapi": "6.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@swc/core": "1.15.46",
    "@tmmin-henkaten/test-fixtures": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.0",
    "supertest": "7.2.2",
    "unplugin-swc": "1.5.9"
  }
}
