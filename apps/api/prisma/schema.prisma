  targetJob                      Job                 @relation("AssignmentMovementTargetJob", fields: [targetJobId, supplierId], references: [id, supplierId], onDelete: Restrict)
  sourceJob                      Job?                @relation("AssignmentMovementSourceJob", fields: [sourceJobId, supplierId], references: [id, supplierId], onDelete: Restrict)
  movedMp                        Member              @relation("AssignmentMovementMp", fields: [movedMpMemberId, supplierId], references: [id, supplierId], onDelete: Restrict)
  replacedMp                     Member?             @relation("AssignmentMovementReplacedMp", fields: [replacedMpMemberId, supplierId], references: [id, supplierId], onDelete: Restrict)
  originatedIssues               AssignmentIssue[]   @relation("AssignmentIssueOriginMovement")

  @@unique([id, supplierId])
  @@unique([henkatenId, supplierId])
  @@index([supplierId, targetShiftRunId, movedAt])
  @@index([supplierId, sourceShiftRunId, movedAt])
  @@index([supplierId, movedMpMemberId, movedAt])
}

model MPReservation {
  id                        String             @id @default(uuid()) @db.Uuid
  supplierId                String             @db.Uuid
  henkatenId                String             @unique @db.Uuid
  shiftRunId                String             @db.Uuid
  replacementMpMemberId     String             @db.Uuid
  targetWorkingAssignmentId String             @db.Uuid
  sourceWorkingAssignmentId String?            @db.Uuid
  targetAssignmentVersion   Int
  sourceAssignmentVersion   Int?
  reservedAt                DateTime           @default(now()) @db.Timestamptz(3)
  expiresAt                 DateTime           @db.Timestamptz(3)
  releasedAt                DateTime?          @db.Timestamptz(3)
  releaseReason             String?            @db.VarChar(50)
  version                   Int                @default(1)
  supplier                  Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  henkaten                  Henkaten           @relation(fields: [henkatenId, supplierId], references: [id, supplierId], onDelete: Restrict)
  shiftRun                  ShiftRun           @relation(fields: [shiftRunId, supplierId], references: [id, supplierId], onDelete: Restrict)
  replacementMp             Member             @relation(fields: [replacementMpMemberId, supplierId], references: [id, supplierId], onDelete: Restrict)
  targetWorkingAssignment   WorkingAssignment  @relation("ReservationTargetWorking", fields: [targetWorkingAssignmentId, supplierId], references: [id, supplierId], onDelete: Restrict)
  sourceWorkingAssignment   WorkingAssignment? @relation("ReservationSourceWorking", fields: [sourceWorkingAssignmentId, supplierId], references: [id, supplierId], onDelete: Restrict)

  @@unique([id, supplierId])
  @@unique([henkatenId, supplierId])
  @@index([supplierId, replacementMpMemberId, releasedAt])
  @@index([supplierId, targetWorkingAssignmentId, releasedAt])
  @@index([supplierId, expiresAt, releasedAt])
}

model WarningInstance {
  id                           String        @id @default(uuid()) @db.Uuid
  supplierId                   String        @db.Uuid
  henkatenId                   String?       @unique @db.Uuid
  externalProjectionId         String?       @unique @db.Uuid
  sourceMode                   SourceMode    @default(HOSTED)
  status                       WarningStatus @default(OPEN)
  partNumberSnapshot           String        @db.VarChar(100)
  normalizedPartNumberSnapshot String        @db.VarChar(100)
  partNameSnapshot             String        @db.VarChar(200)
  openedAt                     DateTime      @default(now()) @db.Timestamptz(3)
  closedAt                     DateTime?     @db.Timestamptz(3)
  closeReason                  String?       @db.VarChar(50)
  version                      Int           @default(1)
  supplier                     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  henkaten                     Henkaten?     @relation(fields: [henkatenId, supplierId], references: [id, supplierId], onDelete: Restrict)
  externalProjection           ExternalHenkatenProjection? @relation(fields: [externalProjectionId, supplierId], references: [id, supplierId], onDelete: Restrict)

  @@unique([id, supplierId])
  @@unique([henkatenId, supplierId])
  @@unique([externalProjectionId, supplierId])
  @@index([supplierId, status, normalizedPartNumberSnapshot, openedAt])
  @@index([status, openedAt])
}

model HenkatenTransition {
  id            String          @id @default(uuid()) @db.Uuid
  supplierId    String          @db.Uuid
  henkatenId    String          @db.Uuid
  fromStatus    HenkatenStatus?
  toStatus      HenkatenStatus
  actorUserId   String          @db.Uuid
  actorRole     UserRole
  actorName     String          @db.VarChar(150)
  reason        String?         @db.VarChar(1000)
  correlationId String          @db.VarChar(128)
  occurredAt    DateTime        @default(now()) @db.Timestamptz(3)
  henkaten      Henkaten        @relation(fields: [henkatenId, supplierId], references: [id, supplierId], onDelete: Restrict)

  @@unique([id, supplierId])
  @@index([supplierId, henkatenId, occurredAt])
}
