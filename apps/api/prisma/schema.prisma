generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum SourceMode {
  HOSTED
  EXTERNAL
}

enum IdentityRealm {
  TMMIN
  SUPPLIER
}

enum UserRole {
  TMMIN_ADMIN
  TMMIN_QUALITY
  SUPPLIER_ADMIN
  SUPERVISOR
  LINE_LEADER
  QC
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SessionPurpose {
  NORMAL
  HOSTED_PREPARATION
}

enum SessionRevocationReason {
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  USER_DEACTIVATED
  USER_REACTIVATED
  ROLE_CHANGED
  SUPPLIER_DEACTIVATED
  SOURCE_MODE_CHANGED
  PREPARATION_CANCELLED
  ADMIN_REPLACED
  OPERATOR_RECOVERY
}

enum HostedPreparationStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum MemberRole {
  SUPERVISOR
  LINE_LEADER
  MP
  QC
}

enum HenkatenCategory {
  MAN
  MACHINE
  MATERIAL
  METHOD
}

enum MemberPhotoState {
  CURRENT
  PENDING_DELETE
  DELETED
}

enum ShiftRunStatus {
  NOT_STARTED
  ACTIVE
  ENDED
}

enum WorkingAssignmentState {
  ASSIGNED
  VACANT
  CONFLICTED
  RESERVED
}

enum AssignmentIssueType {
  VACANCY
  CONFLICT
}

enum AssignmentIssueStatus {
  OPEN
  RESOLVED
  CLOSED_SHIFT_ENDED
}

enum HenkatenStatus {
  OPEN
  APPROVED
  REJECTED
  CANCELLED
}

enum HenkatenCancellationReason {
  WITHDRAWN
  SHIFT_ENDED
}

enum ApprovalRoute {
  SUPERVISOR
  QC
}

enum ApprovalRouteStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

enum ApprovalDecisionValue {
  APPROVED
  REJECTED
}

enum ChecklistAnswer {
  YES
  NO
}

enum WarningStatus {
  OPEN
  CLOSED
}

enum ExternalClientStatus {
  ACTIVE
  REVOKED
}

model Supplier {
  id                     String                  @id @default(uuid()) @db.Uuid
  code                   String                  @db.VarChar(50)
  normalizedCode         String                  @db.VarChar(50)
  name                   String                  @db.VarChar(200)
  timezone               String                  @db.VarChar(100)
  sourceMode             SourceMode
  sourceEpoch            Int                     @default(1)
  active                 Boolean                 @default(true)
  version                Int                     @default(1)
  sourceModeChangedAt    DateTime?               @db.Timestamptz(3)
  sourceModeChangedById  String?                 @db.Uuid
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  createdById            String?                 @db.Uuid
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  updatedById            String?                 @db.Uuid
  users                  User[]
  sessions               UserSession[]
  hostedPreparations     HostedPreparation[]
  auditEvents            AuditEvent[]
  outboxEvents           OutboxEvent[]
  notifications          Notification[]
  members                Member[]
  memberPhotos           MemberPhoto[]
  lines                  Line[]
  jobs                   Job[]
  parts                  Part[]
  shiftTemplates         ShiftTemplate[]
  checklistTemplates     ChecklistTemplate[]
  checklistVersions      ChecklistVersion[]
  defaultAssignmentSet   DefaultAssignmentSet?
  defaultLineSupervisors DefaultLineSupervisor[]
  defaultLineLeaders     DefaultLineLeader[]
  defaultJobMps          DefaultJobMp[]
  shiftRuns              ShiftRun[]
  workingAssignments     WorkingAssignment[]
  assignmentIssues       AssignmentIssue[]
  henkatenDailySequences HenkatenDailySequence[]
  henkatens              Henkaten[]
  mpReservations         MPReservation[]
  warningInstances       WarningInstance[]
  approvalRoutes         HenkatenApprovalRoute[]
  approvalDecisions      ApprovalDecision[]
  approvalRouteRoutings  ApprovalRouteRouting[]
  assignmentMovements    AssignmentMovement[]
  externalApiClients     ExternalApiClient[]
  externalAccessTokens   ExternalAccessToken[]
  externalIngestionEvents ExternalIngestionEvent[]
  externalProjections    ExternalHenkatenProjection[]

  @@unique([normalizedCode], map: "Supplier_normalizedCode_key")
  @@index([sourceMode, active])
}

model User {
  id                         String              @id @default(uuid()) @db.Uuid
  realm                      IdentityRealm
  supplierId                 String?             @db.Uuid
  role                       UserRole
  username                   String              @db.VarChar(100)
  normalizedUsername         String              @db.VarChar(100)
  displayName                String              @db.VarChar(150)
  passwordHash               String              @db.VarChar(512)
  mustChangePassword         Boolean             @default(true)
  passwordEpoch              Int                 @default(1)
  authorizationEpoch         Int                 @default(1)
  failedLoginCount           Int                 @default(0)
  failedLoginWindowStartedAt DateTime?           @db.Timestamptz(3)
  lockedUntil                DateTime?           @db.Timestamptz(3)
  status                     UserStatus          @default(ACTIVE)
  protectedBootstrapAdmin    Boolean             @default(false)
  version                    Int                 @default(1)
  createdAt                  DateTime            @default(now()) @db.Timestamptz(3)
  createdById                String?             @db.Uuid
  updatedAt                  DateTime            @updatedAt @db.Timestamptz(3)
  updatedById                String?             @db.Uuid
  memberId                   String?             @db.Uuid
  supplier                   Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  member                     Member?             @relation(fields: [memberId, supplierId], references: [id, supplierId], onDelete: Restrict)
  sessions                   UserSession[]
  passwordHistory            PasswordHistory[]
  hostedPreparations         HostedPreparation[]
  notifications              Notification[]

  @@unique([memberId])
  @@index([supplierId, role, status])
  @@index([realm, role, status])
}

model UserSession {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @db.Uuid
  supplierId         String?                  @db.Uuid
  realm              IdentityRealm
  purpose            SessionPurpose           @default(NORMAL)
  sourceEpoch        Int?
  passwordEpoch      Int
  authorizationEpoch Int
  tokenHash          Bytes                    @unique
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  lastActivityAt     DateTime                 @db.Timestamptz(3)
  idleExpiresAt      DateTime                 @db.Timestamptz(3)
  absoluteExpiresAt  DateTime                 @db.Timestamptz(3)
  revokedAt          DateTime?                @db.Timestamptz(3)
  revocationReason   SessionRevocationReason?
  sourceIp           String?                  @db.VarChar(45)
  userAgent          String?                  @db.VarChar(512)
  version            Int                      @default(1)
  user               User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  supplier           Supplier?                @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([supplierId, revokedAt])
  @@index([idleExpiresAt, absoluteExpiresAt])
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  passwordHash String   @db.VarChar(512)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
}

model HostedPreparation {
  id                    String                  @id @default(uuid()) @db.Uuid
  supplierId            String                  @db.Uuid
  adminUserId           String                  @db.Uuid
  sourceEpoch           Int
  status                HostedPreparationStatus @default(ACTIVE)
  reason                String                  @db.VarChar(1000)
  privacyAcknowledgedAt DateTime                @db.Timestamptz(3)
  startedAt             DateTime                @default(now()) @db.Timestamptz(3)
  startedById           String                  @db.Uuid
  completedAt           DateTime?               @db.Timestamptz(3)
  completedById         String?                 @db.Uuid
  cancelledAt           DateTime?               @db.Timestamptz(3)
  cancelledById         String?                 @db.Uuid
  version               Int                     @default(1)
  supplier              Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  adminUser             User                    @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([supplierId, status])
}

model AuditEvent {
  id              String      @id @default(uuid()) @db.Uuid
  occurredAt      DateTime    @default(now()) @db.Timestamptz(3)
  actorKind       String      @db.VarChar(30)
  actorUserId     String?     @db.Uuid
  actorRole       UserRole?
  actorSupplierId String?     @db.Uuid
  supplierId      String?     @db.Uuid
  action          String      @db.VarChar(150)
  resourceType    String      @db.VarChar(100)
  resourceId      String?     @db.Uuid
  changeSummary   Json?
  reason          String?     @db.VarChar(1000)
  correlationId   String      @db.VarChar(128)
  sourceIp        String?     @db.VarChar(45)
  userAgent       String?     @db.VarChar(512)
  result          AuditResult
  sourceMode      SourceMode?
  sourceEpoch     Int?
  supplier        Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([supplierId, occurredAt(sort: Desc)])
  @@index([supplierId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId, occurredAt(sort: Desc)])
}

model OutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  eventType        String    @db.VarChar(150)
  schemaVersion    Int
  aggregateType    String    @db.VarChar(100)
  aggregateId      String    @db.Uuid
  aggregateVersion Int
  supplierId       String?   @db.Uuid
  occurredAt       DateTime  @default(now()) @db.Timestamptz(3)
  actor            Json
  correlationId    String    @db.VarChar(128)
  causationId      String?   @db.Uuid
  payload          Json
  availableAt      DateTime  @default(now()) @db.Timestamptz(3)
  attemptCount     Int       @default(0)
  lockedAt         DateTime? @db.Timestamptz(3)
  lockedBy         String?   @db.VarChar(100)
  processedAt      DateTime? @db.Timestamptz(3)
  failedAt         DateTime? @db.Timestamptz(3)
  lastSafeError    String?   @db.VarChar(500)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  supplier         Supplier? @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([processedAt, failedAt, availableAt])
  @@index([supplierId, occurredAt])
  @@index([supplierId, occurredAt, id])
}

model Notification {
  id              String   @id @default(uuid()) @db.Uuid
  supplierId      String   @db.Uuid
  recipientUserId String   @db.Uuid
  sourceEventId   String   @db.Uuid
  kind            String   @db.VarChar(50)
  title           String   @db.VarChar(200)
  body            String   @db.VarChar(1000)
  resourceType    String   @db.VarChar(100)
  resourceId      String   @db.VarChar(200)
  deepLink        String?  @db.VarChar(500)
  readAt          DateTime? @db.Timestamptz(3)
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  recipient       User     @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([sourceEventId, recipientUserId])
  @@index([recipientUserId, readAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([supplierId, createdAt(sort: Desc)])
}

model ExternalApiClient {
  id                        String               @id @default(uuid()) @db.Uuid
  supplierId                String               @db.Uuid
  clientId                  String               @unique @db.VarChar(100)
  name                      String               @db.VarChar(150)
  sourceEpoch               Int
  scopes                    String[]
  ipAllowlist               String[]
  status                    ExternalClientStatus @default(ACTIVE)
  lastSuccessfulIngestionAt DateTime?            @db.Timestamptz(3)
  version                   Int                  @default(1)
  createdAt                 DateTime             @default(now()) @db.Timestamptz(3)
  createdById               String               @db.Uuid
  updatedAt                 DateTime             @updatedAt @db.Timestamptz(3)
  updatedById               String?              @db.Uuid
  supplier                  Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  secrets                   ExternalApiSecret[]
  tokens                    ExternalAccessToken[]
  ingestionEvents           ExternalIngestionEvent[]

  @@unique([id, supplierId])
  @@index([supplierId, status, sourceEpoch])
}

model ExternalApiSecret {
  id          String            @id @default(uuid()) @db.Uuid
  clientId    String            @db.Uuid
  secretHash  String            @db.VarChar(512)
  lastFour    String            @db.Char(4)
  issuedAt    DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime?         @db.Timestamptz(3)
  revokedAt   DateTime?         @db.Timestamptz(3)
  createdById String            @db.Uuid
  client      ExternalApiClient @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId, revokedAt, expiresAt])
}

model ExternalAccessToken {
  id          String            @id @default(uuid()) @db.Uuid
  clientId    String            @db.Uuid
  supplierId  String            @db.Uuid
  sourceEpoch Int
  tokenHash   Bytes             @unique
  scopes      String[]
  sourceIp    String?           @db.VarChar(45)
  issuedAt    DateTime          @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime          @db.Timestamptz(3)
  revokedAt   DateTime?         @db.Timestamptz(3)
  client      ExternalApiClient @relation(fields: [clientId, supplierId], references: [id, supplierId], onDelete: Restrict)
  supplier    Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([clientId, expiresAt, revokedAt])
  @@index([supplierId, sourceEpoch, expiresAt])
}

model ExternalIngestionEvent {
  id                String                     @id @default(uuid()) @db.Uuid
  supplierId        String                     @db.Uuid
  clientId          String                     @db.Uuid
  sourceEpoch       Int
  eventId           String                     @db.VarChar(200)
  sourceHenkatenId  String                     @db.VarChar(200)
  sourceVersion     Int
  eventType         String                     @db.VarChar(50)
  payloadHash       String                     @db.Char(64)
  canonicalPayload  Json
  correlationId     String                     @db.VarChar(128)
  receivedAt        DateTime                   @default(now()) @db.Timestamptz(3)
  projectionId      String?                    @db.Uuid
  supplier          Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  client            ExternalApiClient          @relation(fields: [clientId, supplierId], references: [id, supplierId], onDelete: Restrict)
  projection        ExternalHenkatenProjection? @relation(fields: [projectionId, supplierId], references: [id, supplierId], onDelete: Restrict)

  @@unique([supplierId, sourceEpoch, eventId])
  @@unique([supplierId, sourceEpoch, sourceHenkatenId, sourceVersion])
  @@index([clientId, receivedAt(sort: Desc)])
  @@index([supplierId, receivedAt(sort: Desc)])
}

model ExternalHenkatenProjection {
  id                         String                   @id @default(uuid()) @db.Uuid
  supplierId                 String                   @db.Uuid
  sourceEpoch                Int
  sourceHenkatenId           String                   @db.VarChar(200)
  sourceVersion              Int
  status                     HenkatenStatus
  category                   HenkatenCategory
  occurredAt                 DateTime                 @db.Timestamptz(3)
  lineSnapshot               Json
  shiftSnapshot              Json
  jobSnapshot                Json
  partSnapshot               Json
  changeSnapshot             Json
  checklistSnapshot          Json
  decisionsSnapshot          Json
  lastEventId                String                   @db.VarChar(200)
  createdAt                  DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                 @updatedAt @db.Timestamptz(3)
  supplier                   Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  ingestionEvents            ExternalIngestionEvent[]
  warning                    WarningInstance?

  @@unique([id, supplierId])
  @@unique([supplierId, sourceEpoch, sourceHenkatenId])
  @@index([supplierId, status, updatedAt(sort: Desc)])
  @@index([supplierId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
}

model Member {
  id                           String                  @id @default(uuid()) @db.Uuid
  supplierId                   String                  @db.Uuid
  fullName                     String                  @db.VarChar(150)
  registrationNumber           String                  @db.VarChar(100)
  normalizedRegistrationNumber String                  @db.VarChar(100)
  role                         MemberRole
  active                       Boolean                 @default(true)
  version                      Int                     @default(1)
  createdAt                    DateTime                @default(now()) @db.Timestamptz(3)
  createdById                  String?                 @db.Uuid
  updatedAt                    DateTime                @updatedAt @db.Timestamptz(3)
  updatedById                  String?                 @db.Uuid
  supplier                     Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  users                        User[]
  photos                       MemberPhoto[]
  supervisedLines              DefaultLineSupervisor[]
  ledLines                     DefaultLineLeader[]
  assignedJobs                 DefaultJobMp[]
  supervisedShiftRuns          ShiftRun[]              @relation("ShiftRunSupervisor")
  ledShiftRuns                 ShiftRun[]              @relation("ShiftRunLineLeader")
  effectiveWorkingAssignments  WorkingAssignment[]     @relation("WorkingEffectiveMp")
  candidateWorkingAssignments  WorkingAssignment[]     @relation("WorkingCandidateMp")
  replacedManHenkatens         ManHenkatenDetail[]     @relation("ManReplacedMp")
  replacementManHenkatens      ManHenkatenDetail[]     @relation("ManReplacementMp")
  createdHenkatens             Henkaten[]              @relation("HenkatenCreator")
  reservations                 MPReservation[]
  initialApprovalRoutes        HenkatenApprovalRoute[] @relation("ApprovalInitialSupervisor")
  currentApprovalRoutes        HenkatenApprovalRoute[] @relation("ApprovalCurrentSupervisor")
  approvalDecisions            ApprovalDecision[]      @relation("ApprovalDecisionActorMember")
  routingHistoryFrom           ApprovalRouteRouting[]  @relation("ApprovalRoutingFromMember")
  routingHistoryTo             ApprovalRouteRouting[]  @relation("ApprovalRoutingToMember")
  movedAssignmentMovements     AssignmentMovement[]    @relation("AssignmentMovementMp")
  replacedAssignmentMovements  AssignmentMovement[]    @relation("AssignmentMovementReplacedMp")

  @@unique([supplierId, normalizedRegistrationNumber])
  @@unique([id, supplierId])
  @@index([supplierId, active, role])
  @@index([supplierId, fullName])
  @@index([supplierId, active, fullName, id])
}

model MemberPhoto {
  id                String           @id @default(uuid()) @db.Uuid
  supplierId        String           @db.Uuid
  memberId          String           @db.Uuid
  state             MemberPhotoState @default(CURRENT)
  fullPath          String           @db.VarChar(500)
  thumbnailPath     String           @db.VarChar(500)
  fullChecksum      String           @db.VarChar(64)
  thumbnailChecksum String           @db.VarChar(64)
  fullWidth         Int
  fullHeight        Int
  thumbnailWidth    Int
  thumbnailHeight   Int
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  createdById       String?          @db.Uuid
  supersededAt      DateTime?        @db.Timestamptz(3)
  deletedAt         DateTime?        @db.Timestamptz(3)
  version           Int              @default(1)
  supplier          Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  member            Member           @relation(fields: [memberId, supplierId], references: [id, supplierId], onDelete: Restrict)

  @@unique([id, supplierId])
  @@index([supplierId, memberId, state])
}

model Line {
  id                 String                 @id @default(uuid()) @db.Uuid
  supplierId         String                 @db.Uuid
  code               String                 @db.VarChar(100)
  normalizedCode     String                 @db.VarChar(100)
  name               String                 @db.VarChar(150)
  displayOrder       Int
  active             Boolean                @default(true)
  version            Int                    @default(1)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  createdById        String?                @db.Uuid
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  updatedById        String?                @db.Uuid
  supplier           Supplier               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  jobs               Job[]
  defaultSupervisor  DefaultLineSupervisor?
  defaultLineLeader  DefaultLineLeader?
  shiftRuns          ShiftRun[]
  workingAssignments WorkingAssignment[]
  assignmentIssues   AssignmentIssue[]
  henkatens          Henkaten[]
  targetMovements    AssignmentMovement[] @relation("AssignmentMovementTargetLine")
  sourceMovements    AssignmentMovement[] @relation("AssignmentMovementSourceLine")

  @@unique([supplierId, normalizedCode])
  @@unique([id, supplierId])
  @@index([supplierId, active, displayOrder])
}

model Job {
  id                 String              @id @default(uuid()) @db.Uuid
  supplierId         String              @db.Uuid
  lineId             String              @db.Uuid
  name               String              @db.VarChar(150)
  normalizedName     String              @db.VarChar(150)
  displayOrder       Int
  active             Boolean             @default(true)
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  createdById        String?             @db.Uuid
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  updatedById        String?             @db.Uuid
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  line               Line                @relation(fields: [lineId, supplierId], references: [id, supplierId], onDelete: Restrict)
  defaultMp          DefaultJobMp?
  workingAssignments WorkingAssignment[]
  assignmentIssues   AssignmentIssue[]
  henkatens          Henkaten[]
  targetMovements    AssignmentMovement[] @relation("AssignmentMovementTargetJob")
  sourceMovements    AssignmentMovement[] @relation("AssignmentMovementSourceJob")

  @@unique([lineId, normalizedName])
  @@unique([id, supplierId])
  @@index([supplierId, lineId, active, displayOrder])
  @@index([supplierId, lineId, active, displayOrder, id])
}

model Part {
  id                   String     @id @default(uuid()) @db.Uuid
  supplierId           String     @db.Uuid
  partNumber           String     @db.VarChar(100)
  normalizedPartNumber String     @db.VarChar(100)
  partName             String     @db.VarChar(200)
  normalizedPartName   String     @db.VarChar(200)
  active               Boolean    @default(true)
  version              Int        @default(1)
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  createdById          String?    @db.Uuid
  updatedAt            DateTime   @updatedAt @db.Timestamptz(3)
  updatedById          String?    @db.Uuid
  supplier             Supplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  henkatens            Henkaten[]

  @@unique([supplierId, normalizedPartNumber])
  @@unique([id, supplierId])
  @@index([supplierId, active, normalizedPartName])
}

model ShiftTemplate {
  id           String     @id @default(uuid()) @db.Uuid
  supplierId   String     @db.Uuid
  name         String     @db.VarChar(150)
  displayOrder Int
  startMinute  Int
  endMinute    Int
  timezone     String     @db.VarChar(100)
  active       Boolean    @default(true)
  version      Int        @default(1)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  createdById  String?    @db.Uuid
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
  updatedById  String?    @db.Uuid
  supplier     Supplier   @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  shiftRuns    ShiftRun[]

  @@unique([id, supplierId])
  @@index([supplierId, active, displayOrder])
}

model ChecklistTemplate {
  id          String               @id @default(uuid()) @db.Uuid
  supplierId  String               @db.Uuid
  category    HenkatenCategory
  active      Boolean              @default(true)
  version     Int                  @default(1)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  createdById String?              @db.Uuid
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  updatedById String?              @db.Uuid
  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  draftItems  ChecklistDraftItem[]
  versions    ChecklistVersion[]

  @@unique([supplierId, category])
  @@unique([id, supplierId])
}

model ChecklistDraftItem {
  id              String            @id @default(uuid()) @db.Uuid
  templateId      String            @db.Uuid
  supplierId      String            @db.Uuid
  label           String            @db.VarChar(500)
  normalizedLabel String            @db.VarChar(500)
  displayOrder    Int
  template        ChecklistTemplate @relation(fields: [templateId, supplierId], references: [id, supplierId], onDelete: Restrict)

  @@unique([templateId, normalizedLabel])
  @@index([supplierId, templateId, displayOrder])
}

model ChecklistVersion {
