APP_ENV=staging
RELEASE_SHA=0000000000000000000000000000000000000000
DEPLOY_RUN_NUMBER=1
COMPOSE_PROJECT_NAME=supplier-henkaten-staging
SHARED_DIR=/tmp/supplier-henkaten-staging/shared
SUPPLIER_DOMAIN=supplier-henkaten.qd-tmmin.site
TMMIN_DOMAIN=henkaten.qd-tmmin.site
API_DOMAIN=supplier-henkaten-api.qd-tmmin.site
CADDY_EMAIL=operator@example.com
CADDY_SCHEME=http://
PUBLISHED_HTTP_PORT=18080
PUBLISHED_HTTPS_PORT=18443
POSTGRES_USER=supplier_henkaten
POSTGRES_PASSWORD=replace_me_with_32_safe_characters
POSTGRES_DATABASE=supplier_henkaten
SESSION_CSRF_SECRET=replace_me_with_32_safe_characters
AUTH_THROTTLE_SECRET=replace_me_with_32_safe_characters
TMMIN_BOOTSTRAP_USERNAME=bootstrap_admin
TMMIN_BOOTSTRAP_DISPLAY_NAME="TMMIN Bootstrap Admin"
TMMIN_BOOTSTRAP_PASSWORD=replace_me_with_32_safe_characters
LOG_LEVEL=info
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_LOCK_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=10
REALTIME_POLL_MS=1000
AUTH_IP_LOGIN_LIMIT=50
AUTH_GLOBAL_LIMIT_PER_MINUTE=300
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
