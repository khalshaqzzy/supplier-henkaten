{
  "name": "supplier-henkaten",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.23.1 <23",
    "pnpm": "11.16.0"
  },
  "scripts": {
    "runtime:check": "node scripts/check-runtime.mjs",
    "dev": "pnpm -r --parallel --if-present run dev",
    "clean": "pnpm -r --if-present run clean",
    "shared:build": "pnpm --filter @tmmin-henkaten/contracts run build && pnpm --filter @tmmin-henkaten/test-fixtures run build",
    "build": "pnpm -r --sort --if-present run build",
    "typecheck": "pnpm shared:build && pnpm -r --sort --if-present run typecheck",
    "lint": "pnpm shared:build && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm shared:build && pnpm -r --sort --if-present run test",
    "validate": "pnpm runtime:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "node scripts/database.mjs up",
    "db:wait": "node scripts/database.mjs wait",
    "db:verify": "node scripts/database.mjs verify",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:test:reset": "node scripts/database.mjs test-reset",
    "db:down": "node scripts/database.mjs down",
    "db:destroy": "node scripts/database.mjs destroy"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
